# Local development. Copy to .env and adjust only what you need.
HOST=127.0.0.1
PORT=8001
ENV=development
ENFORCE_AUTH=true
# Generate a stable secret: python -c "import secrets; print(secrets.token_hex(32))"
# Production requires a secret; development generates one if this is empty.
API_SECRET=
# DATABASE_URL defaults to SQLite under SENTIO_HOME/data.
# DATABASE_URL=sqlite:///C:/ai project/data/tutor_sessions.db
QDRANT_MODE=local
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=phi3:mini
